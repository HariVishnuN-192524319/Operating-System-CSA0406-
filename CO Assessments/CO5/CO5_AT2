QUESTION 01:
File System Space Management Algorithm
Pseudocode:
  BEGIN
  SET threshold = 80%
  GET current disk usage
  IF disk usage > threshold THEN
      DISPLAY "Warning: Disk usage exceeds 80%"
      IDENTIFY all log files
      SORT log files by size in descending order
      FOR each log file DO
          IF log file is old THEN
              ROTATE log file
              COMPRESS rotated log file
          ELSE
              COMPRESS log file
          ENDIF
          GET current disk usage
          IF disk usage <= 80% THEN
              BREAK
          ENDIF
      ENDFOR
      IF disk usage > 80% THEN
          DELETE oldest compressed log files
      ENDIF
  ELSE
      DISPLAY "Disk usage is within safe limit"
  ENDIF
  DISPLAY current disk usage
  END

QUESTION 02:
Priority-Based CPU Scheduling Algorithm
Pseudocode:
  BEGIN
  INPUT process_list
  FOR each process IN process_list DO
      READ process_id
      READ priority
      READ burst_time
  ENDFOR
  SORT process_list BY priority in descending order
  WHILE process_list is NOT EMPTY DO
      SELECT process WITH highest priority
      ALLOCATE CPU to selected process
      EXECUTE process
      IF process is completed THEN
          REMOVE process from process_list
          DISPLAY "Process completed"
      ELSE
          REDUCE process priority slightly
          ADD process back to process_list
      ENDIF
      SORT process_list BY priority in descending order
  ENDWHILE
  DISPLAY "All processes completed"
  END

