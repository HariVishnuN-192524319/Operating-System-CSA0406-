QUESTION 1: logical-to-physical address translation using Base and Limit Registers.
C CODE: 
  #include <stdio.h>
    int main() {
        int base, limit, logical, physical;
        printf("Enter Base Register value: ");
        scanf("%d", &base);
        printf("Enter Limit Register value: ");
        scanf("%d", &limit);
        printf("Enter Logical Address: ");
        scanf("%d", &logical);
        if (logical >= 0 && logical < limit) {
            physical = base + logical;
            printf("\nLogical Address is VALID.\n");
            printf("Physical Address = %d\n", physical);
        } else {
            printf("\nInvalid Logical Address! Address Trap.\n");
        }
        return 0;
    }

