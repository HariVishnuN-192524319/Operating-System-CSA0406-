QUESTION 4: Translation Lookaside Buffer (TLB) and Effective Memory Access Time (EMAT)
C CODE:
  #include <stdio.h>
  int main() {
      float hitRatio, tlbTime, memTime, emat;
      printf("Enter TLB access time: ");
      scanf("%f", &tlbTime);
      printf("Enter Memory access time: ");
      scanf("%f", &memTime);
      printf("Enter TLB hit ratio (0 to 1): ");
      scanf("%f", &hitRatio);
      // Effective Memory Access Time (EMAT)
      emat = hitRatio * (tlbTime + memTime) +
             (1 - hitRatio) * (tlbTime + 2 * memTime);
      printf("\nWithout TLB = %.2f ns", 2 * memTime);
      printf("\nWith TLB (EMAT) = %.2f ns", emat);
      return 0;
  }

OUTPUT:
Enter TLB access time: 10
Enter Memory access time: 100
Enter TLB hit ratio (0 to 1): 0.8

Without TLB = 200.00 ns
With TLB (EMAT) = 130.00 ns

