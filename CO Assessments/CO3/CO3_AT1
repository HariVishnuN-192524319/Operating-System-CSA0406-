QUESTION 3: Logical to Physical Address Translation using Page Table.
C CODE:
  #include <stdio.h>
  int main() {
      int pt[10], n, size, page, offset, frame, physical, i;
      printf("Enter number of pages: ");
      scanf("%d",&n);
      printf("Enter page size: ");
      scanf("%d",&size);
      printf("Enter frame numbers:\n");
      for(i=0;i<n;i++)
          scanf("%d",&pt[i]);
      printf("Enter page number: ");
      scanf("%d",&page);
      printf("Enter offset: ");
      scanf("%d",&offset);
      printf("\n PAGE TABLE \n");
      printf("Page\tFrame\n");
      for(i=0;i<n;i++)
          printf("%d\t%d\n", i, pt[i]);
      if(page>=0 && page<n&&offset>=0&&offset<size) {
          frame = pt[page];
          physical = frame * size + offset;
          printf("\nTranslation:\n");
          printf("Page Number  : %d\n", page);
          printf("Frame Number : %d\n", frame);
          printf("Offset       : %d\n", offset);
          printf("Physical Address = %d\n", physical);
      }
      else {
          printf("\nInvalid Logical Address\n");
      }
      return 0;
  }

